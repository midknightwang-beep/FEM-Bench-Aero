<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 0, fontFamily: 'Microsoft YaHei', position: 'relative' }}>
  <Box style={{ position: 'absolute', left: 80, top: 28, right: 80 }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1A1A1A' }}>六层技术架构</Text>
    <Box style={{ width: 56, height: 4, background: '#1565C0', marginTop: 10 }} />
  </Box>
  <Box style={{ position: 'absolute', left: 80, top: 130, width: 380, flexDirection: 'column', gap: 22 }}>
    <Text style={{ fontSize: 18, color: '#1A1A1A', lineHeight: 1.7 }}>
      框架自上而下分六层：<span style={{ fontWeight: 'bold' }}>大模型交互</span>产出建模意图，
      <span style={{ fontWeight: 'bold' }}>FEASpec 唯一契约</span>一次声明全链生效，
      生成层自动完成建面、网格与双后端写卡，双求解器独立求解。
    </Text>
    <Text style={{ fontSize: 18, color: '#1A1A1A', lineHeight: 1.7 }}>
      数据集不是附属产物，而是框架的<span style={{ fontWeight: 'bold', color: '#1565C0' }}>标尺与地基</span>——
      交互层靠它评测，生成层靠它校准，验证层靠它对照真值。
    </Text>
    <Box style={{ background: '#F1F5F9', borderRadius: 10, padding: '16px 20px', borderLeft: '4px solid #06B6D4' }}>
      <Text style={{ fontSize: 16, color: '#334155', lineHeight: 1.6 }}>
        每一次生成都能给出量化偏差，而不是"看起来对"
      </Text>
    </Box>
  </Box>
  <svg width={700} height={480} viewBox='0 0 700 480' style={{ position: 'absolute', right: 80, top: 140 }}>
    <defs>
      <marker id='arr' viewBox='0 0 10 10' refX='8' refY='5' markerWidth='6' markerHeight='6' orient='auto-start-reverse'>
        <path d='M2 1L8 5L2 9' fill='none' stroke='#64748B' strokeWidth='1.5' />
      </marker>
    </defs>
    {[
      { y: 10, t: '① 交互层 · 大模型', s: '自然语言理解 / 追问澄清 / spec 草稿', f: '#1565C0' },
      { y: 88, t: '② 契约层 · FEASpec', s: '几何·网格·材料·载荷·边界·求解器', f: '#1E6FC2' },
      { y: 166, t: '③ 生成层 · 参数化建模', s: '建面打标 → 全四边形网格 → 双后端 deck', f: '#2779C4' },
      { y: 244, t: '④ 求解层 · 双求解器', s: 'CalculiX ⟷ Abaqus 交叉验证', f: '#3082C6' },
      { y: 322, t: '⑤ 验证层 · 九道质量闸', s: '网格/语义/平衡/双码/退化/回归/去重', f: '#398BC8' },
      { y: 400, t: '⑥ 应用层 · 交付与回流', s: '模型交付 · 强度分析 · 数据回流', f: '#4294CA' },
    ].map((L, i) => (
      <g key={i}>
        <rect x='10' y={L.y} width='430' height='66' rx='8' fill={L.f} />
        <text x='225' y={L.y + 26} textAnchor='middle' fontSize='16' fontWeight='bold' fill='#FFFFFF' fontFamily='Microsoft YaHei'>{L.t}</text>
        <text x='225' y={L.y + 48} textAnchor='middle' fontSize='12' fill='rgba(255,255,255,0.85)' fontFamily='Microsoft YaHei'>{L.s}</text>
        {i < 5 && <line x1='225' y1={L.y + 66} x2='225' y2={L.y + 78} stroke='#64748B' strokeWidth='1.5' markerEnd='url(#arr)' />}
      </g>
    ))}
    <rect x='520' y='10' width='170' height='456' rx='10' fill='#FFF7ED' stroke='#E65100' strokeWidth='1.5' />
    <text x='605' y='48' textAnchor='middle' fontSize='15' fontWeight='bold' fill='#E65100' fontFamily='Microsoft YaHei'>FEM-Bench-Aero</text>
    <text x='605' y='70' textAnchor='middle' fontSize='12' fill='#9A3412' fontFamily='Microsoft YaHei'>数据集 · 四条机制</text>
    <line x1='560' y1='96' x2='560' y2='430' stroke='#E65100' strokeWidth='1' strokeDasharray='4 4' />
    {[
      { y: 43, l: '评测语料' }, { y: 199, l: '建模基准' }, { y: 355, l: '真值对照' },
    ].map((a, i) => (
      <g key={i}>
        <line x1='520' y1={a.y} x2='446' y2={a.y} stroke='#E65100' strokeWidth='1.5' markerEnd='url(#arr)' />
        <text x='483' y={a.y - 10} textAnchor='middle' fontSize='11' fill='#E65100' fontFamily='Microsoft YaHei'>{a.l}</text>
      </g>
    ))}
  </svg>
  <Box style={{ position: 'absolute', left: 80, bottom: 24, right: 80, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 12, color: '#94A3B8' }}>基于大模型的飞机有限元模型智能生成技术</Text>
    <Text style={{ fontSize: 14, color: '#94A3B8' }}>04 / 15</Text>
  </Box>
</Slide>
