<Slide style={{ width: 1280, height: 720, background: '#0F172A', padding: 0, position: 'relative', fontFamily: 'Microsoft YaHei' }}>
  <svg width={1280} height={720} viewBox='0 0 1280 720' style={{ position: 'absolute', top: 0, left: 0 }}>
    <rect x='0' y='0' width='1280' height='6' fill='url(#band5)' />
    <defs>
      <linearGradient id='band5' x1='0' y1='0' x2='1' y2='0'>
        <stop offset='0%' stopColor='#1565C0' />
        <stop offset='100%' stopColor='#06B6D4' />
      </linearGradient>
    </defs>
    <rect width='1280' height='720' fill='url(#grid5)' />
    <pattern id='grid5' width='64' height='64' patternUnits='userSpaceOnUse'>
      <path d='M64 0H0V64' fill='none' stroke='rgba(255,255,255,0.04)' strokeWidth='1' />
    </pattern>
    <circle cx='640' cy='330' r='250' fill='none' stroke='rgba(21,101,192,0.25)' strokeWidth='1.5' />
    <circle cx='640' cy='330' r='175' fill='none' stroke='rgba(6,182,212,0.2)' strokeWidth='1.5' />
  </svg>
  <Box style={{ position: 'absolute', left: 0, right: 0, top: 190, alignItems: 'center' }}>
    <Text style={{ fontSize: 64, fontWeight: 'bold', color: '#FFFFFF', textAlign: 'center', lineHeight: 1.3, marginBottom: 22 }}>
      每一份生成模型<br />可信 · 可量化 · 可复现
    </Text>
    <Box style={{ width: 96, height: 6, background: 'linear-gradient(90deg, #1565C0 0%, #06B6D4 100%)', marginBottom: 34 }} />
    <Box style={{ flexDirection: 'row', gap: 56, alignItems: 'center' }}>
      {[
        { v: '41 × 2', l: '数据集规模' },
        { v: '九道闸', l: '质量体系全绿' },
        { v: '0.003%', l: '双码交叉偏差' },
      ].map((k, i) => (
        <Box key={i} style={{ alignItems: 'center' }}>
          <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#E65100', marginBottom: 6 }}>{k.v}</Text>
          <Text style={{ fontSize: 15, color: 'rgba(255,255,255,0.6)' }}>{k.l}</Text>
        </Box>
      ))}
    </Box>
  </Box>
  <Box style={{ position: 'absolute', left: 0, right: 0, bottom: 90, alignItems: 'center' }}>
    <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#FFFFFF' }}>谢谢，请领导与专家批评指正</Text>
  </Box>
  <Box style={{ position: 'absolute', left: 100, bottom: 44, right: 80, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 12, color: 'rgba(255,255,255,0.45)' }}>基于大模型的飞机有限元模型智能生成技术 · 2026 年 10 月</Text>
    <Text style={{ fontSize: 14, color: 'rgba(255,255,255,0.55)' }}>15 / 15</Text>
  </Box>
</Slide>
