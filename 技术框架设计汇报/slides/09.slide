    ].map((x, i) => (
      <Box key={i} style={{ flex: 1, height: 92, background: '#E3F2FD', borderRadius: 8, padding: '14px 16px', borderTop: '3px solid #1565C0' }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0D47A1' }}>{x.g}</Text>
        <Text style={{ fontSize: 12.5, color: '#334155', marginTop: 4 }}>{x.d}</Text>
        <Text style={{ fontSize: 11, color: '#B91C1C', marginTop: 4 }}>失败即拒绝（{x.k}）</Text>
      </Box>
    ))}
  </Box>
  <Box style={{ position: 'absolute', left: 80, top: 262, right: 80, flexDirection: 'row', gap: 16 }}>
    {[
      { g: 'G4 双码一致', d: '两求解器位移/应力偏差在阈值内', k: '软' },
