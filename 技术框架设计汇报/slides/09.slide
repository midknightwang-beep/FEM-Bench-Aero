    ].map((x, i) => (
      <Box key={i} style={{ flex: 1, height: 92, background: i < 2 ? '#FFF7ED' : '#E3F2FD', borderRadius: 8, padding: '14px 16px', borderTop: `3px solid ${i < 2 ? '#E65100' : '#1565C0'}` }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: i < 2 ? '#E65100' : '#0D47A1' }}>{x.g}</Text>
        <Text style={{ fontSize: 12.5, color: '#334155', marginTop: 4 }}>{x.d}</Text>
        <Text style={{ fontSize: 11, color: i < 2 ? '#9A3412' : '#B91C1C', marginTop: 4 }}>{i < 2 ? '带标记放行（软）' : '失败即拒绝（硬）'}</Text>
      </Box>
    ))}
  </Box>
  <Box style={{ position: 'absolute', left: 80, top: 364, right: 80, flexDirection: 'row', gap: 16 }}>
    {[
      { g: 'G7 去重指纹', d: '网格 + 壳厚 + 材料律唯一', k: '硬' },
      { g: 'G8 回归基线', d: '与归档基线比对，无未声明漂移', k: '软' },
      { g: 'G9 契约自洽', d: '双真相量一致、字段约束成立', k: '硬' },
    ].map((x, i) => (
      <Box key={i} style={{ flex: 1, height: 92, background: i === 1 ? '#FFF7ED' : '#E3F2FD', borderRadius: 8, padding: '14px 16px', borderTop: `3px solid ${i === 1 ? '#E65100' : '#1565C0'}` }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: i === 1 ? '#E65100' : '#0D47A1' }}>{x.g}</Text>
        <Text style={{ fontSize: 12.5, color: '#334155', marginTop: 4 }}>{x.d}</Text>
        <Text style={{ fontSize: 11, color: i === 1 ? '#9A3412' : '#B91C1C', marginTop: 4 }}>{i === 1 ? '要求说明并重签（软）' : '失败即拒绝（硬）'}</Text>
      </Box>
    ))}
  </Box>
  <Box style={{ position: 'absolute', left: 80, top: 476, right: 80 }}>
