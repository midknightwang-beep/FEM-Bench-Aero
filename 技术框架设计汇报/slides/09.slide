      <Box key={i} style={{ flex: 1, height: 96, background: '#F8FAFC', borderRadius: 8, padding: '12px 14px', borderLeft: '3px solid #00897B' }}>
        <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#00695C' }}>{x.t}</Text>
