  <Box style={{ position: 'absolute', left: 80, top: 566, right: 80, flexDirection: 'row', gap: 14 }}>
    {[
      { t: '复材：等效单层', d: '不做真分层，代价是无层间应力' },
      { t: '生成：检索+约束', d: '不先上微调，代价受检索覆盖限制' },
      { t: '编排：单流程+工具', d: '不做自由多智能体，代价灵活性略低' },
