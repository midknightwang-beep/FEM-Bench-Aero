<Slide style={{ width: 1280, height: 720, background: '#0D47A1', padding: 0, fontFamily: 'Microsoft YaHei', position: 'relative' }}>
  <Box style={{ position: 'absolute', left: 96, top: 150, width: 620, flexDirection: 'column', gap: 18 }}>
    <Text style={{ fontSize: 15, color: '#90CAF9', letterSpacing: 3 }}>技术框架设计报告 · 汇报版</Text>
    <Text style={{ fontSize: 42, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.35 }}>基于大模型的交互式{'\n'}飞机有限元模型智能生成技术</Text>
    <Box style={{ width: 72, height: 4, background: '#4DB6AC', marginTop: 6 }} />
    <Text style={{ fontSize: 19, color: 'rgba(255,255,255,0.82)', lineHeight: 1.8 }}>需求背景 · 现状调研 · 设计思路 · 总体设计 · 具体方案</Text>
    <Text style={{ fontSize: 13, color: 'rgba(255,255,255,0.55)', marginTop: 24 }}>2026 年 10 月 ｜ 版本 V1.0</Text>
  </Box>
  <svg width='380' height='420' viewBox='0 0 380 420' style={{ position: 'absolute', right: 96, top: 150 }}>
    {[0, 1, 2, 3, 4, 5].map((i) => (
      <g key={i}>
        <rect x='40' y={20 + i * 64} width='300' height='52' rx='8'
              fill='rgba(255,255,255,0.10)' stroke='rgba(144,202,249,0.55)' strokeWidth='1.2' />
        <text x='60' y={52 + i * 64} fontSize='14' fill='#E3F2FD' fontFamily='Microsoft YaHei'>
          {['L1  交互层 · 意图', 'L2  契约层 · 唯一真相', 'L3  生成层 · 建面网格写卡', 'L4  求解层 · 双码互证', 'L5  验证层 · 九道闸', 'L6  应用层 · 交付回流'][i]}
        </text>
      </g>
    ))}
  </svg>
</Slide>
