<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 0, fontFamily: 'Microsoft YaHei', position: 'relative' }}>
  <Box style={{ position: 'absolute', left: 80, top: 48, right: 80 }}>
    <Text style={{ fontSize: 15, color: '#1565C0', letterSpacing: 2 }}>02 现状调研</Text>
    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#1A1A1A', marginTop: 6 }}>三代技术谱系：我们站在什么位置</Text>
    <Box style={{ width: 56, height: 4, background: '#1565C0', marginTop: 10 }} />
  </Box>
  <svg width='1120' height='250' viewBox='0 0 1120 250' style={{ position: 'absolute', left: 80, top: 170 }}>
    <defs>
      <marker id='ar1' viewBox='0 0 10 10' refX='8' refY='5' markerWidth='7' markerHeight='7' orient='auto'>
        <path d='M2 1L8 5L2 9' fill='none' stroke='#64748B' strokeWidth='1.6' />
      </marker>
    </defs>
    {[
      { x: 0, t: '第一代 · 参数化/模板化', b: '尺寸驱动几何与网格\n确定性强、可复现', l: '覆盖窄 · 维护贵 · 门槛高', f: '#E3F2FD', s: '#1565C0' },
      { x: 380, t: '第二代 · 脚本化自动化', b: '脚本驱动前处理与批处理\n可复现、可批量化', l: '要双技能 · 缺语义', f: '#E8F5E9', s: '#2E7D32' },
      { x: 760, t: '第三代 · 大模型生成', b: '自然语言 → 结构化意图\n交互自然、可编排', l: '输出不确定 · 须独立验证', f: '#FFF3E0', s: '#E65100' },
    ].map((g, i) => (
      <g key={i}>
        <rect x={g.x} y='0' width='320' height='160' rx='10' fill={g.f} stroke={g.s} strokeWidth='1.8' />
        <text x={g.x + 160} y='32' textAnchor='middle' fontSize='16' fontWeight='bold' fill={g.s} fontFamily='Microsoft YaHei'>{g.t}</text>
        {g.b.split('\n').map((line, j) => (
          <text key={j} x={g.x + 160} y={64 + j * 24} textAnchor='middle' fontSize='13' fill='#1A1A1A' fontFamily='Microsoft YaHei'>{line}</text>
        ))}
        <text x={g.x + 160} y='140' textAnchor='middle' fontSize='12' fill='#B91C1C' fontFamily='Microsoft YaHei'>局限：{g.l}</text>
        {i < 2 && <line x1={g.x + 324} y1='80' x2={g.x + 356} y2='80' stroke='#64748B' strokeWidth='1.8' markerEnd='url(#ar1)' />}
      </g>
    ))}
    <rect x='0' y='190' width='1080' height='48' rx='8' fill='#F1F5F9' />
    <text x='24' y='221' fontSize='14' fill='#0D47A1' fontFamily='Microsoft YaHei'>
      本框架定位：继承第二代的确定性与可复现，补上第三代的自然交互，并用「契约 + 验证闸」消除第三代的不确定性
    </text>
  </svg>
  <Box style={{ position: 'absolute', left: 80, top: 460, right: 80, flexDirection: 'row', gap: 18 }}>
    {[
      { t: '继承什么', d: '模板的参数化思想、脚本的批处理与可复现' },
      { t: '改变什么', d: '交互从"人适应软件"变成"软件理解人"' },
      { t: '新增什么', d: '契约约束 + 独立验证 + 双码互证' },
    ].map((x, i) => (
      <Box key={i} style={{ flex: 1, height: 118, background: '#F8FAFC', borderRadius: 10, padding: '16px 18px', borderLeft: '4px solid #00897B' }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#00695C' }}>{x.t}</Text>
        <Text style={{ fontSize: 14, color: '#475569', marginTop: 6, lineHeight: 1.6 }}>{x.d}</Text>
      </Box>
    ))}
  </Box>
  <Box style={{ position: 'absolute', left: 80, bottom: 24, right: 80, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 12, color: '#94A3B8' }}>技术框架设计报告</Text>
    <Text style={{ fontSize: 14, color: '#94A3B8' }}>04 / 12</Text>
  </Box>
</Slide>
